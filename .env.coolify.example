# Coolify environment — Visitors Log System
# Copy into Coolify UI → Environment Variables

NODE_ENV=production
PORT=4000
TRUST_PROXY=1

# ── Coolify service URL ──────────────────────────────────────────────────────
SERVICE_URL_NODE_TEMPLATE=https://visitors.wgzm.net
SERVICE_FQDN_NODE_TEMPLATE=visitors.wgzm.net

APP_URL=https://visitors.wgzm.net
CORS_ORIGINS=https://visitors.wgzm.net

# ── Database (Coolify PostgreSQL — internal hostname) ────────────────────────
DATABASE_URL=postgres://postgres:PASSWORD@INTERNAL_HOST:5432/postgres

# ── Security (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_TOKEN_SECRET=

DEFAULT_ADMIN_EMAIL=admin@wgzm.net
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Visitors Log Admin

# ── Notifications (optional) ─────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@wgzm.net
EMAIL_FROM_NAME=Visitors Log System
SMS_PROVIDER=console
# Optional Ontech fallback (prefer Admin → Settings → SMS):
# ONTECH_EMAIL=
# ONTECH_PASSWORD=
# ONTECH_SENDER_ID=
# ONTECH_BASE_URL=https://bulksms.ontech.co.zm/api

# ── Frontend build/runtime ───────────────────────────────────────────────────
VITE_API_URL=/api
VITE_ADMIN_IDLE_TIMEOUT_MINUTES=30
