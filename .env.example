# Visitors Log System — Environment variables (copy to .env)

NODE_ENV=development
PORT=4000

# Database — use ONE of the following:
#
# PostgreSQL (Coolify / production):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
#
# MySQL (local development):
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wgvl

# Optional override when DATABASE_URL is unset
# DB_DRIVER=postgres

# Auth (required in production)
AUTH_TOKEN_SECRET=change-me-to-a-long-random-string

# Default super admin (seeded once if no admin exists)
DEFAULT_ADMIN_EMAIL=admin@template.dev
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Visitors Log Admin

# Portal dev users password (development only, never in production)
DEV_PORTAL_PASSWORD=demo1234

# CORS (comma-separated origins, optional in dev)
# CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Kiosk (defaults to demo-org organisation)
# KIOSK_ORG_SLUG=demo-org

# ── Email notifications ──────────────────────────────────────
# Provider: console | sendgrid | smtp  (default: console — logs to terminal)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@visitors.local
EMAIL_FROM_NAME=Visitors Log System

# SendGrid (when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=SG.xxxx

# SMTP (when EMAIL_PROVIDER=smtp — requires: npm install nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# ── SMS notifications ────────────────────────────────────────
# Provider: console | twilio | ontech  (default: console — logs to terminal)
# Prefer configuring via Admin → Settings → SMS; env is a fallback.
SMS_PROVIDER=console

# Twilio (when SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM_NUMBER=+1234567890

# Ontech Bulk SMS (when SMS_PROVIDER=ontech)
# ONTECH_ACCESS_ID=your_api_key
# ONTECH_SENDER_ID=VisitorsLog
# ONTECH_BASE_URL=https://bulksms.ontech.co.zm/smsservice

# Delivery retry (background worker in server/index.js)
# NOTIFICATION_MAX_ATTEMPTS=3
# NOTIFICATION_RETRY_INTERVAL_MS=60000

VITE_API_BASE=http://localhost:4000/api
VITE_ADMIN_IDLE_TIMEOUT_MINUTES=30
